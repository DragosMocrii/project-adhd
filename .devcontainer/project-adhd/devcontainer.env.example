# Optional per-project configuration for the Dev Container.
# Copy this file to devcontainer.env locally and fill in values as needed.

# Which agent CLIs to install and verify.
# Comma-separated; valid values: claude, codex, gemini, omp
# Leave unset or empty to select all four.
#   AGENT_TOOLS=claude
#   AGENT_TOOLS=claude,codex
AGENT_TOOLS=claude,codex,gemini,omp

# Optional credentials for developer tooling.
CONTEXT7_API_KEY=

# Gemini CLI state and credentials persist in its mounted ~/.gemini volume.
# OMP Superpowers requires claude in AGENT_TOOLS and an authenticated Claude.
