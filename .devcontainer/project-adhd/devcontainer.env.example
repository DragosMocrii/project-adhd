# Optional per-project configuration for the Dev Container.
# Copy this file to devcontainer.env locally and fill in values as needed.

# Which agent CLIs to install and verify.
# Comma-separated; valid values: claude, codex, omp, antigravity
# Leave unset or empty to select all available tools.
#   AGENT_TOOLS=claude
#   AGENT_TOOLS=claude,codex
AGENT_TOOLS=claude,codex,omp,antigravity

# Where agent credentials, plugins, and settings live.
#   shared  (default) one set of volumes shared by every attached repository
#   project           volumes private to this repository; log in separately here
# Changing it requires Dev Containers: Rebuild Container.
AGENT_STATE_SCOPE=

# Optional credentials for developer tooling.
CONTEXT7_API_KEY=

# Antigravity settings share the mounted ~/.gemini volume. OAuth uses an OS
# keyring and may not persist with the current container configuration.
# OMP Superpowers requires claude in AGENT_TOOLS and an authenticated Claude.
